# nimi-service settings — example with placeholders. Do not put real secrets in this file (it is committed).
#
# Copy it and fill in real values in ONE of these places (neither is committed to git):
#   - nimi-service/.env                  in the repo folder (easy to find)      ← overrides the next one
#   - ~/.config/nimi/service.env         outside the repo (created by db/bootstrap.sh)
#   e.g.  cp nimi-service/env.example nimi-service/.env
# Real environment variables override both. NIMI_ENV=/path/to/file uses exactly that file instead.
# Check what is in effect (secrets masked):  .venv/bin/python -m nimi_service config
#
# Every setting is commented out: uncomment only what you need. Most setups need a database password
# (NIMI_DB_PASSWORD, NIMI_DB_PASSWORD_FILE, or ~/.pgpass).

# --- Database ------------------------------------------------------------------------------------------
# Credentials are separate so they can come from a secrets manager (Vault Agent, k8s secrets, ...):
# set NIMI_DB_PASSWORD, or point NIMI_DB_PASSWORD_FILE at a file containing only the password,
# or set neither and let libpq use ~/.pgpass / trust / peer auth.
# NIMI_DB_HOST=127.0.0.1
# NIMI_DB_PORT=5432
# NIMI_DB_NAME=nimi
# NIMI_DB_USER=nimi_service
# NIMI_DB_PASSWORD=<password>           # takes priority over NIMI_DB_PASSWORD_FILE and ~/.pgpass
# NIMI_DB_PASSWORD_FILE=/run/secrets/nimi_db_password
# NIMI_DB_SSLMODE=require              # for remote / managed Postgres

# --- Skill history access (nimi-sql) --------------------------------------------------------------------
# RCA runs can query past bot messages and previous RCAs with read-only SQL through a role that can read only the
# skill_messages and skill_rcas views. db/bootstrap.sh creates the role; `db upgrade` grants the views.
# NIMI_SKILL_HISTORY=true
# NIMI_DB_SKILL_USER=nimi_skill_reader
# NIMI_DB_SKILL_PASSWORD=<password>     # or NIMI_DB_SKILL_PASSWORD_FILE, or ~/.pgpass
# NIMI_DB_SKILL_PASSWORD_FILE=/run/secrets/nimi_skill_db_password

# --- Admin notifications (red flags) ---------------------------------------------------------------------
# Incoming webhook of the admin's Google Chat space (Apps & integrations -> Webhooks). Secret.
# NIMI_ADMIN_WEBHOOK=https://chat.googleapis.com/v1/spaces/<space>/messages?key=<key>&token=<token>

# --- Messaging providers -------------------------------------------------------------------------------
# Google Chat user OAuth token (created by `python -m nimi_service gchat-login --client-secret <file>`).
# NIMI_GCHAT_TOKEN_FILE=~/.config/nimi/gchat-token.json     # default

# --- Posting replies -----------------------------------------------------------------------------------
# NIMI_POST_ENABLED=false               # start with a dry run: RCAs are stored, not posted
# NIMI_POST_TARGET=thread              # thread | webhook | both — see docs: Guides → Where replies go
# NIMI_POST_WEBHOOK=https://chat.googleapis.com/v1/spaces/<space>/messages?key=<key>&token=<token>   # secret
# NIMI_POST_MAX_CHARS=4000
# NIMI_REPLY_DISCLAIMER="automated RCA, not verified by a person. …"   # text after "👁️ NIMI —" in every reply

# --- Polling -------------------------------------------------------------------------------------------
# NIMI_POLL_SECONDS=60
# NIMI_BACKFILL_DAYS=90                 # history pulled on a channel's first ingest
# NIMI_REACTION_DAYS=7                  # how far back reactions on RCA replies are re-checked

# --- Triage --------------------------------------------------------------------------------------------
# NIMI_TRIAGE_MODEL=haiku
# NIMI_REUSE_DAYS=7                     # an earlier RCA can be reused within this window

# --- RCA runs ------------------------------------------------------------------------------------------
# NIMI_ALERT_SENDERS=                   # comma-separated sender IDs allowed to trigger RCAs (empty = any bot)
# NIMI_MAX_PER_DAY=50                   # daily cap on RCA runs (UTC)
# NIMI_MAX_PARALLEL=2
# NIMI_RCA_TIMEOUT_SECONDS=900
# NIMI_SYNC_MINUTES=10                  # update projects marked "sync" in the registry at most this often
# NIMI_RCA_PROJECT=<repo>/nimi-skill          # where the /rca skill lives (default: next to nimi-service)
# NIMI_CLAUDE_BIN=claude

# --- Claude account / config ---------------------------------------------------------------------------
# NIMI's Claude calls get a clean environment: only these settings decide the account and config
# (ANTHROPIC_* variables from your shell are NOT passed through).
# NIMI_CLAUDE_CONFIG_DIR=~/.claude-nimi       # separate Claude login + user config (log in once:
#                                             #   CLAUDE_CONFIG_DIR=~/.claude-nimi claude  -> /login). Keep it
#                                             #   outside the repo (it holds login tokens). Unset = ~/.claude
# NIMI_ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key   # API billing instead of the stored login
# NIMI_CLAUDE_SETTING_SOURCES=user,project    # settings layers for RCA runs; "project" = ignore user settings
#                                             #   (triage never loads any settings)
# NIMI_CLAUDE_PASS_ENV=                       # extra env vars to pass through, e.g. HTTPS_PROXY,NO_PROXY

# --- When Claude is unavailable (usage limit, credit, auth) ------------------------------------------------
# All Claude calls pause; ingestion continues; pending alert threads get a "RCA delayed" notice.
# NIMI_LIMIT_COOLDOWN_MINUTES=15        # retry after this long when Claude gives no reset time
# NIMI_STALE_HOURS=6                    # alerts older than this when NIMI can process them get no RCA
#                                       #   (after downtime, a restart, or a usage-limit pause)

# --- Guard ---------------------------------------------------------------------------------------------
# NIMI_GUARD_DENIAL_LOG=/home/<you>/.local/state/nimi/guard-denials.jsonl
